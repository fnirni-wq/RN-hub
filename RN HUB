--============================================================
-- 5) HELPERS
--============================================================
local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function tpTo(pos)
    local hrp = getHRP()
    if hrp then hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end
end

local function firePrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        fireproximityprompt(prompt)
    end
end

--============================================================
-- 6) AUTO FARM (tapis roulant / money farm)
--============================================================
local function findTreadmill()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("tread") or obj.Name:lower():find("farm")) then
            return obj
        end
    end
end

local function autoFarmLoop()
    while State.AutoFarm do
        pcall(function()
            local t = findTreadmill()
            if t then
                tpTo(t.Position)
                task.wait(0.1)
                for _, p in pairs(t:GetDescendants()) do
                    if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
                end
            end
        end)
        task.wait(State.FarmDelay)
    end
end

--============================================================
-- 7) AUTO STEAL
--============================================================
local function findEggs()
    local eggs = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart"))
           and obj.Name:lower():find("egg")
           and not obj.Name:lower():find("player") then
            table.insert(eggs, obj)
        end
    end
    return eggs
end

-- Récupère le pivot d'une base appartenant au joueur
local function getMyBase()
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:lower():find(LP.Name:lower()) then return obj end
    end
end

local function isOnMyBase(egg)
    local base = getMyBase()
    if not base then return false end
    local part = egg:IsA("Model") and egg.PrimaryPart or egg
    if not part then return false end
    local ok, pivot = pcall(function() return base:GetPivot().Position end)
    return ok and (part.Position - pivot).Magnitude < 40
end

local function stealEgg(egg)
    local part = egg:IsA("Model") and egg.PrimaryPart or egg
    if not part then return end
    tpTo(part.Position)
    task.wait(0.15)
    -- Essaie les ProximityPrompt
    for _, d in pairs(egg:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            fireproximityprompt(d)
            task.wait(0.1)
        end
    end
    -- ⚠️ Si le jeu utilise un RemoteEvent à la place :
    -- ReplicatedStorage.Remotes.StealEgg:FireServer(egg)
end

local function autoStealLoop()
    while State.AutoSteal do
        pcall(function()
            local hrp = getHRP()
            if not hrp then return end
            for _, egg in pairs(findEggs()) do
                if not State.AutoSteal then break end
                if not isOnMyBase(egg) then
                    local part = egg:IsA("Model") and egg.PrimaryPart or egg
                    if part and (part.Position - hrp.Position).Magnitude <= State.StealRange then
                        stealEgg(egg)
                    end
                end
            end
        end)
        task.wait(0.3)
    end
end

--============================================================
-- 8) AUTO HATCH / SELL
--============================================================
local function autoPromptLoop(keyword, stateKey)
    while State[stateKey] do
        pcall(function()
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt")
                   and obj.ActionText:lower():find(keyword) then
                    tpTo(obj.Parent.Position)
                    task.wait(0.2)
                    fireproximityprompt(obj)
                end
            end
        end)
        task.wait(1)
    end
end

